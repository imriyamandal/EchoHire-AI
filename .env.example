# ==============================================================================
# EchoHire AI - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# All external API integrations include built-in fallback modes for offline/demo use.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENV=development

# JWT Secret Key for Session Authentication
JWT_SECRET_KEY=echohire_ai_jwt_secret_2026_super_secure_key

# ------------------------------------------------------------------------------
# Rime TTS (Primary Voice Output Engine)
# Get your API key at: https://rime.ai
# Supported voices in 'mist' model: allison, amber, creek, marsh, bayou
# ------------------------------------------------------------------------------
RIME_API_KEY=your_rime_api_key_here
RIME_DEFAULT_SPEAKER=allison
RIME_MODEL_ID=mist
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_WS_URL=wss://users-ws.rime.ai/ws3

# ------------------------------------------------------------------------------
# Deepgram STT (Speech-to-Text & Filler Word Detection)
# Get your API key at: https://deepgram.com
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# LiveKit WebRTC (Real-Time Voice Transport)
# Get your credentials at: https://cloud.livekit.io
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# LLM Providers (Google Gemini & OpenAI)
# ------------------------------------------------------------------------------
# Google Gemini (Primary / Fast Inference)
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# OpenAI GPT (Optional secondary provider)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Database Configuration
# SQLite default for local development, PostgreSQL supported for production.
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./echohire.db

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/duplex
